{
  "name": "zod-ai-tool",
  "version": "1.1.0",
  "description": "Derive Anthropic, OpenAI, and Gemini tool definitions from a Zod schema — one source, no drift.",
  "keywords": [
    "zod",
    "ai",
    "anthropic",
    "openai",
    "gemini",
    "google",
    "tool-use",
    "json-schema",
    "typescript"
  ],
  "author": "Connor Dibble <dibbleconnor@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/connordibble/zod-ai-tool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/connordibble/zod-ai-tool.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/connordibble/zod-ai-tool/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "zod": "^3.25.28 || ^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@eslint/js": "^9.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "openai": "^6.42.0",
    "semantic-release": "^25.0.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0",
    "zod": "^4.3.6"
  }
}
